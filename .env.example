# ESPN fantasy football league ID.
export ESPN_LEAGUE_ID=""

# ESPN espn_s2 cookie value for authenticated league API requests.
export ESPN_ESPNS2=""

# ESPN SWID cookie value for authenticated league API requests.
export ESPN_SWID=""

# Fantasy football season year to analyze and publish podcasts for.
export CURRENT_YEAR=""

# OpenAI API key used for podcast transcript generation and text-to-speech.
export OPENAI_API_KEY=""

# OpenAI model used to generate podcast transcripts.
export PODCAST_MODEL="gpt-4.1"

# OpenAI text-to-speech model used to generate podcast MP3 files.
export PODCAST_TTS_MODEL="gpt-4o-mini-tts"

# OpenAI text-to-speech voice used for podcast audio.
export PODCAST_VOICE="verse"

# Set to true to allow local podcast commands to overwrite an existing generated episode.
export PODCAST_FORCE_RUN="false"
